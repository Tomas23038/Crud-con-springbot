    {
      "name": "CRUD - criatura",
      "item": [
        {
          "name": "Crear zona",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Zona creada: status 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\nconst zone = pm.response.json();\r\npm.test(\"La zona trae id y los datos enviados\", function () {\r\n    pm.expect(zone).to.have.property(\"id\");\r\n    pm.expect(zone.name).to.eql(\"Zona Pruebas Postman\");\r\n    pm.expect(zone.capacity).to.eql(10);\r\n    pm.expect(zone.creatureCount).to.eql(0);\r\n});\r\npm.environment.set(\"zoneId\", zone.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\":\"Zona Pruebas Postman\",\r\n    \"description\":\"Creada por la colección\",\r\n    \"capacity\":10\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/zones",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
