                "exec": [
                  "pm.test(\"Status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Devuelve un arreglo\", function () {\r\n    pm.expect(pm.response.json()).to.be.an(\"array\");\r\n});\r\npm.test(\"La lista contiene la criatura creada\", function () {\r\n    const ids = pm.response.json().map(c => c.id);\r\n    pm.expect(ids).to.include(pm.environment.get(\"creatureId\"));\r\n});"
